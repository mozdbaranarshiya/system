# Example ONLY. Do not commit real secrets.
# Supabase injects its standard URL/keys into Edge Functions in production.
SUPABASE_URL=https://YOUR_REAL_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=SET_PUBLIC_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=SET_ONLY_IN_SUPABASE_SECRETS
CHATGPT_OAUTH_CLIENT_ID=SET_REGISTERED_CHATGPT_CLIENT_ID
# Keep this false. Set true only after JWT email/metadata no longer expose national IDs.
CHATGPT_OAUTH_PRIVACY_SAFE=false
