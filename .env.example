# Server-only Supabase Edge Function configuration. Values are placeholders.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_KEY
OAUTH_SITE_URL=https://YOUR_SCHOOL_DOMAIN/system/index.html
OAUTH_ALLOWED_ORIGINS=https://YOUR_SCHOOL_DOMAIN
# Allow HTTP localhost URLs only in isolated local development, never production.
OAUTH_ALLOW_LOCAL_HTTP=false
